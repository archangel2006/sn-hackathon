# ── Student Support Agent · Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# Leave blank to run fully on the built-in mock/rule engine (no API keys needed).

# ── LLM (optional – enables richer agent responses) ─────────────────────────
# Get a free Gemini key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Or OpenAI:
OPENAI_API_KEY=
# Provider: 'gemini', 'openai', or 'auto' (tries Gemini first, then OpenAI, then rule engine)
LLM_PROVIDER=auto

# ── ServiceNow (optional – enables live PDI case creation) ──────────────────
# Fill these in if you have a ServiceNow PDI instance
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SERVICENOW_TABLE=u_student_support_case

# ── Server ───────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── Frontend ─────────────────────────────────────────────────────────────────
# Update this if your Next.js dev server runs on a different port
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
